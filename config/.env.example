# Modelo usado pela Yuri Code AI
LLM_API_KEY=
LLM_MODEL=gpt-5.5
LLM_BASE_URL=

# Workspace do agente: pode criar/editar/testar projetos aqui
YURI_WORKSPACE=./workspace

# API HTTP do agente
YURI_API_HOST=0.0.0.0
YURI_API_PORT=8000

# URL usada pela interface Next.js para falar com o agente Python.
# Em desenvolvimento local: http://localhost:8000
YURI_AGENT_API_URL=http://localhost:8000

# Banco: opcional. Sem esta variável, usa SQLite local em .yuri-data/yuri_code_ai.db
# Para produção, use PostgreSQL, por exemplo:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/yuri_code_ai
DATABASE_URL=
YURI_DATA_DIR=.yuri-data

# Pesquisa web adicional. Opcional porque o BrowserToolSet já permite navegação direta.
# Crie sua chave em https://app.tavily.com/
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
